# Build output. make release writes here; nothing in it is source.
/releases/

# The local SQLite database the app creates when you run it, and its
# write-ahead log. Real data lives on the platform, never in the repo.
/myapp.db
/myapp.db-wal
/myapp.db-shm

# make dev's rastrillo generate writes an empty router here while
# manifest/ holds no manifests; make dev removes it on exit (see the
# Makefile). The day a manifest lands, gen/ is source: delete this.
/gen/
